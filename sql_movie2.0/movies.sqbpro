INSERT INTO movies VALUES

('Dune', 'Denis Villeneuve', 2021),

('Spider-Man: No Way Home', 'Jon Watts', 2021),

('Top Gun: Maverick', 'Joseph Kosinski', 2022),

('Oppenheimer', 'Christopher Nolan', 2023),

('Barbie', 'Greta Gerwig', 2023),

('The Batman', 'Matt Reeves', 2022),

('Everything Everywhere All at Once', 'Daniel Kwan &amp; Daniel Scheinert', 2022),

('Avatar: The Way of Water', 'James Cameron', 2022);



select * from movies



select director, count(*) as total_movies

from movies

group by director

order by total_movies desc

select* from movies order by year desc;



select* from movies where year=2022;



select director, avg(year) as avg_year

from movies 

group by director</sql><sql name="SQL 2*">DROP TABLE IF EXISTS movies;



CREATE TABLE movies (

    title TEXT,

    director TEXT,

    year INTEGER,

    box_office REAL

);



INSERT INTO movies VALUES

('Dune', 'Denis Villeneuve', 2021, 402),

('Spider-Man: No Way Home', 'Jon Watts', 2021, 1921),

('Top Gun: Maverick', 'Joseph Kosinski', 2022, 1495),

('Oppenheimer', 'Christopher Nolan', 2023, 950),

('Barbie', 'Greta Gerwig', 2023, 1440),

('The Batman', 'Matt Reeves', 2022, 770),

('Everything Everywhere All at Once', 'Daniel Kwan', 2022, 143),

('Avatar: The Way of Water', 'James Cameron', 2022, 2320);



SELECT *

FROM movies

ORDER BY box_office DESC;



SELECT director, AVG(box_office) AS avg_box_office

FROM movies

GROUP BY director;



SELECT director, COUNT(*) AS total_movies

FROM movies

GROUP BY director

ORDER BY total_movies DESC;



SELECT *

FROM movies

WHERE year &gt; 2021;



SELECT *

FROM movies

ORDER BY box_office DESC

LIMIT 3;</sql><current_tab id="1"/></tab_sql></sqlb_project>
